# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paddle Billing v2 Configuration
# Client Token from Paddle Dashboard -> Developer Tools -> Authentication Tokens
VITE_PADDLE_CLIENT_TOKEN="live_195af09cd4dcad3eb49692c55e2"
# Set to 'production' for live payments or 'sandbox' for testing
VITE_PADDLE_ENV="production"

# Price IDs from Paddle Catalog
VITE_PADDLE_PRICE_PRO_MONTHLY="pri_01kz4hybt73v5q4mww0gyn5hbk"
VITE_PADDLE_PRICE_PRO_ANNUAL="pri_01kz4j1y54jybgmpt5ehgz7g2r"
VITE_PADDLE_PRICE_ENTERPRISE_MONTHLY="pri_01kz4hzd18djqsg05gcaad2wj8"
VITE_PADDLE_PRICE_ENTERPRISE_ANNUAL="pri_01kz4j4351x35afwx2fxdv0ead"

